# ── MCP Server ──────────────────────────────────────────────────────────────
# Random string used to authenticate Claude/ChatGPT connections to this server.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=change_me_generate_a_strong_random_token

# Key used to encrypt stored OAuth tokens in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_me_generate_with_fernet

# Public base URL of this server (used for OAuth callbacks).
# Examples:
#   VPS:               https://mail.yourdomain.com
#   Cloudflare Tunnel: https://xxxx.trycloudflare.com
BASE_URL=https://your-domain.com

# Web UI password (simple HTTP basic auth)
WEB_UI_PASSWORD=change_me

# ── Gmail ────────────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Outlook ──────────────────────────────────────────────────────────────────
# From Azure Portal → App registrations → your app
OUTLOOK_CLIENT_ID=4e6f4857-0024-44ed-a678-4aae39fa20bb
OUTLOOK_CLIENT_SECRET=your_new_secret_here
# Use "common" to support both personal and org accounts
OUTLOOK_TENANT_ID=common

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/accounts.db
